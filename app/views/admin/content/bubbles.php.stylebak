.af-edit-mask{position:absolute;inset:0;background:rgba(0,0,0,.4)}
.af-edit-card{position:relative;background:var(--card-bg,#fff);border-radius:16px;width:min(680px,95vw);max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2)}
.af-edit-head{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;border-bottom:1px solid var(--line-soft,#e2e8f0)}

// 消息红点轮询（桌面端 + 下拉菜单）
(function(){
  var desktopBadge = document.getElementById('desktopMsgBadge');
  var topbarBadge = document.getElementById('topbarMsgBadge');
  if (!desktopBadge && !topbarBadge) return;
  function checkUnread(){
    fetch('/api.php?path=messages/unread', {credentials:'same-origin'})
      .then(function(r){ return r.json(); })
      .then(function(d){
        var count = d.count || 0;
        var text = count > 99 ? '99+' : (count > 0 ? count : '');
        var show = count > 0;
        if (desktopBadge) {
          desktopBadge.style.display = show ? 'block' : 'none';
          desktopBadge.textContent = text;
        }
        if (topbarBadge) {
          topbarBadge.style.display = show ? 'block' : 'none';
          topbarBadge.textContent = text;
        }
      }).catch(function(){});
  }
 /* ── Bubble effect activation ── */
 function activateBubbleEffects(container){
  if(!window.BubbleEffects)return;
  (container||document).querySelectorAll('.chat-msg.mine.has-bubble[data-effect]').forEach(function(el){
    if(el.dataset.fxActive)return;
    el.dataset.fxActive='1';
    var et=el.dataset.effect,ep=el.dataset.effectParams||'{}';
    try{BubbleEffects.applyToChatMsg(el,et,JSON.parse(ep))}catch(e){}
  });
 }
 /* Activate on existing messages */
 setTimeout(function(){activateBubbleEffects()},500);
 /* MutationObserver for new messages */
 var chatMsgBox=document.getElementById('chatMsgBox');
 var chatGroupMsgBox=document.getElementById('chatGroupMsgBox');
 var fxObserver=new MutationObserver(function(muts){
  muts.forEach(function(m){
   m.addedNodes.forEach(function(n){
    if(n.nodeType===1){
     if(n.classList&&n.classList.contains('has-bubble'))activateBubbleEffects(n.parentElement||n);
     else if(n.querySelectorAll)activateBubbleEffects(n);
    }
   });
  });
 });
 if(chatMsgBox)fxObserver.observe(chatMsgBox,{childList:true});
 if(chatGroupMsgBox)fxObserver.observe(chatGroupMsgBox,{childList:true});
 /* Re-activate on AJAX message load */
 var origRender=window.renderMessages||null;
 var origGroupRender=window.renderGroupMessages||null;

 checkUnread();
 setInterval(checkUnread, 30000);
})();

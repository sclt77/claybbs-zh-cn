// 论坛前台操作型 AJAX 表单：仅处理显式 data-ajax-refresh 的表单，避免误伤发帖/登录/资料上传等复杂表单。
(function(){
  if (window.__clayFrontAjaxForms) return;
  window.__clayFrontAjaxForms = true;
  function toast(msg, type){
    var wrap=document.querySelector('.front-toast-wrap');
    if(!wrap){wrap=document.createElement('div');wrap.className='front-toast-wrap';wrap.style.cssText='position:fixed;right:18px;top:76px;z-index:99999;display:grid;gap:10px;max-width:min(340px,calc(100vw - 32px));';document.body.appendChild(wrap);}
    var el=document.createElement('div');el.textContent=msg||'操作成功';el.style.cssText='background:'+(type==='err'?'#991b1b':'#166534')+';color:#fff;border-radius:14px;padding:11px 14px;box-shadow:0 18px 45px rgba(15,23,42,.22);font-size:13px;line-height:1.5;';wrap.appendChild(el);
    setTimeout(function(){el.style.opacity='0';el.style.transform='translateY(-6px)';},1800);
    setTimeout(function(){el.remove();},2300);
  }
  document.addEventListener('submit', function(e){
    var form=e.target;
    if(!form || !form.hasAttribute('data-ajax-refresh') || form.method.toLowerCase()!=='post') return;
    if(e.defaultPrevented) return;
    e.preventDefault();
    var btn=e.submitter || form.querySelector('button[type=submit],button:not([type])');
    var old=btn?btn.textContent:'';
    if(btn){btn.disabled=true;btn.textContent='处理中...';}
    var fd=new FormData(form);
    if(btn && btn.name && !fd.has(btn.name)){
      fd.append(btn.name, btn.value || '');
    }
    var action=form.getAttribute('action') || location.href;
    var pathInput=fd.get('path');
    if(pathInput && action.indexOf('?')===-1){action += '?path=' + encodeURIComponent(pathInput);}
    fetch(action, {method:'POST',body:fd,credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'text/html,application/json'}})
      .then(function(res){if(!res.ok) throw new Error('HTTP '+res.status); return res.text();})
      .then(function(text){var payload=null;try{payload=JSON.parse(text);}catch(e){} toast('操作成功','ok'); if(payload&&payload.redirect){setTimeout(function(){location.href=payload.redirect;},300);}else if(payload&&payload.reload){setTimeout(function(){location.reload();},450);}else if(!form.hasAttribute('data-stay-on-success')){setTimeout(function(){location.reload();},450);}})
      .catch(function(err){toast('操作失败：'+err.message,'err');})
      .finally(function(){if(btn){btn.disabled=false;btn.textContent=old;}});
  }, false);
})();



